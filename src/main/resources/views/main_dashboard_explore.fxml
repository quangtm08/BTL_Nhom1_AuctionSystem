<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<HBox fx:id="mainContainer" prefHeight="800.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@../css/main_dashboard_explore.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <VBox prefWidth="260.0" styleClass="sidebar" HBox.hgrow="NEVER">
        <padding>
            <Insets top="80.0" left="25.0" right="25.0" bottom="30.0"/>
        </padding>
        <children>
            <VBox spacing="12.0" VBox.vgrow="ALWAYS">
                <Button text="Explore" maxWidth="Infinity" styleClass="side-btn, side-btn-active"/>
                <Button text="My bids" maxWidth="Infinity" styleClass="side-btn"/>
                <Button text="My listings" maxWidth="Infinity" styleClass="side-btn"/>
                <Button text="Payments" maxWidth="Infinity" styleClass="side-btn"/>
            </VBox>
            
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="user-footer">
                <Circle radius="18.0" fill="#3a3a3a" stroke="#4a4a4a"/>
                <Label text="bruh" styleClass="user-label" style="-fx-text-fill: white;"/>
            </HBox>
        </children>
    </VBox>

    <VBox spacing="35.0" HBox.hgrow="ALWAYS" styleClass="main-content">
        <padding>
            <Insets top="60.0" left="60.0" right="60.0" bottom="30.0"/>
        </padding>
        <children>
            <Label text="Hunt for the next deal, bruh" styleClass="header-title"/>
            
            <VBox spacing="20.0">
                <TextField promptText="Search..." styleClass="search-field"/>
                <HBox alignment="CENTER_LEFT">
                    <HBox spacing="10.0" HBox.hgrow="ALWAYS">
                        <Button text="All" styleClass="filter-chip, filter-chip-active"/>
                        <Button text="Electronics" styleClass="filter-chip"/>
                        <Button text="Arts" styleClass="filter-chip"/>
                        <Button text="Vehicles" styleClass="filter-chip"/>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Label text="Sort by" styleClass="sort-label" style="-fx-text-fill: #666666;"/>
                        <Button text="Ending soon" styleClass="filter-chip, filter-chip-active"/>
                    </HBox>
                </HBox>
            </VBox>

            <ScrollPane fitToWidth="true" styleClass="custom-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <GridPane hgap="30.0" vgap="30.0">
                        <padding>
                            <Insets bottom="30.0" right="20.0" />
                        </padding>
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" />
                        </columnConstraints>
                        <children>
                            <VBox styleClass="product-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="Vintage Fender Guitar" styleClass="card-title-text"/>
                                        <Label text="Art &amp; Collectibles" styleClass="card-sub-text"/>
                                    </VBox>
                                    <Label text="Winning" styleClass="status-badge"/>
                                </HBox>
                                <Region prefHeight="50.0" />
                                <HBox alignment="BOTTOM_LEFT">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="Current bid" styleClass="card-sub-text"/>
                                        <Label text="\$5000" styleClass="card-price-text"/>
                                    </VBox>
                                    <VBox alignment="BOTTOM_RIGHT" spacing="10">
                                        <Label text="2 days" styleClass="card-sub-text"/>
                                        <Button text="Raise bid" styleClass="btn-action-green"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox styleClass="product-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="Macintosh 1984" styleClass="card-title-text"/>
                                        <Label text="Electronics" styleClass="card-sub-text"/>
                                    </VBox>
                                    <Label text="Outbid" styleClass="status-badge" style="-fx-text-fill: #ff4d4d; -fx-background-color: #331a1a;"/>
                                </HBox>
                                <Region prefHeight="50.0" />
                                <HBox alignment="BOTTOM_LEFT">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="Current bid" styleClass="card-sub-text"/>
                                        <Label text="\$2400" styleClass="card-price-text"/>
                                    </VBox>
                                    <VBox alignment="BOTTOM_RIGHT" spacing="10">
                                        <Label text="5 hours" styleClass="card-sub-text"/>
                                        <Button text="Raise bid" styleClass="btn-action-green"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox styleClass="product-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="Leica M6 Camera" styleClass="card-title-text"/>
                                        <Label text="Photography" styleClass="card-sub-text"/>
                                    </VBox>
                                    <Label text="Winning" styleClass="status-badge"/>
                                </HBox>
                                <Region prefHeight="50.0" />
                                <HBox alignment="BOTTOM_LEFT">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="Current bid" styleClass="card-sub-text"/>
                                        <Label text="\$3200" styleClass="card-price-text"/>
                                    </VBox>
                                    <VBox alignment="BOTTOM_RIGHT" spacing="10">
                                        <Label text="12 hours" styleClass="card-sub-text"/>
                                        <Button text="Raise bid" styleClass="btn-action-green"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox styleClass="product-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="Eames Lounge Chair" styleClass="card-title-text"/>
                                        <Label text="Furniture" styleClass="card-sub-text"/>
                                    </VBox>
                                    <Label text="Winning" styleClass="status-badge"/>
                                </HBox>
                                <Region prefHeight="50.0" />
                                <HBox alignment="BOTTOM_LEFT">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="Current bid" styleClass="card-sub-text"/>
                                        <Label text="\$1800" styleClass="card-price-text"/>
                                    </VBox>
                                    <VBox alignment="BOTTOM_RIGHT" spacing="10">
                                        <Label text="1 day" styleClass="card-sub-text"/>
                                        <Button text="Raise bid" styleClass="btn-action-green"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            </children>
                    </GridPane>
                </content>
            </ScrollPane>
        </children>
    </VBox>
</HBox>