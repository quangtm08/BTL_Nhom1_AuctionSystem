<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<StackPane prefHeight="855.0" prefWidth="1320.0" styleClass="root-pane" stylesheets="@../css/register.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom1.auction.client.Controller.RegisterController">
   <children>
      <HBox fillHeight="true" maxHeight="Infinity" maxWidth="Infinity" prefHeight="855.0" prefWidth="1320.0" styleClass="split-layout">
         <children>
            <StackPane maxHeight="Infinity" maxWidth="Infinity" prefWidth="610.0" styleClass="left-pane" HBox.hgrow="ALWAYS">
               <children>
                  <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="left-image" />
                  <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="left-overlay" />
                  <VBox alignment="CENTER" fillWidth="true" maxHeight="Infinity" maxWidth="Infinity" styleClass="left-shell">
                     <children>
                        <VBox alignment="CENTER" maxWidth="480.0" spacing="28.0" styleClass="left-content">
                           <children>
                              <StackPane prefHeight="260.0" prefWidth="340.0" styleClass="image-placeholder">
                                 <children>
                                    <Label styleClass="image-placeholder-label" text="IMAGE PLACEHOLDER" />
                                 </children>
                              </StackPane>

                              <TextFlow maxWidth="480.0" styleClass="quote-flow" textAlignment="CENTER">
                                 <children>
                                    <Text styleClass="quote-text" text="when there are things " />
                                    <Text styleClass="quote-emphasis" text="worth fighting for" />
                                 </children>
                              </TextFlow>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </StackPane>

            <StackPane maxHeight="Infinity" maxWidth="Infinity" prefWidth="710.0" styleClass="right-pane" HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER_LEFT" fillWidth="true" maxWidth="594.0" prefWidth="594.0" spacing="30.0" styleClass="form-shell">
                     <StackPane.margin>
                        <Insets left="56.0" right="60.0" />
                     </StackPane.margin>
                     <children>
                        <VBox spacing="24.0">
                           <children>
                              <TextFlow lineSpacing="0.0">
                                 <children>
                                    <Text styleClass="title-initial" text="C" />
                                    <Text styleClass="title-rest" text="reat an account" />
                                 </children>
                              </TextFlow>

                              <Label maxWidth="520.0" styleClass="supporting-text" text="Join 9999 other collectors and win your first bid" wrapText="true" />
                           </children>
                        </VBox>

                        <VBox spacing="24.0">
                           <children>
                              <VBox spacing="10.0" styleClass="field-card">
                                 <children>
                                    <Label styleClass="field-label" text="Username or Email" />
                                    <TextField styleClass="field-input" />
                                 </children>
                              </VBox>

                              <VBox spacing="10.0" styleClass="field-card">
                                 <children>
                                    <Label styleClass="field-label" text="Password" />
                                    <PasswordField styleClass="field-input" />
                                 </children>
                              </VBox>

                              <VBox spacing="10.0" styleClass="field-card">
                                 <children>
                                    <Label styleClass="field-label" text="Confirm Password" />
                                    <PasswordField styleClass="field-input" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>

                        <Button fx:id="btnRegister" maxWidth="Infinity" mnemonicParsing="false" prefHeight="71.1489" styleClass="primary-button" text="Register" />

                        <HBox alignment="CENTER_LEFT" spacing="4.0">
                           <children>
                              <Label styleClass="supporting-text" text="Already have an account?" />
                              <Button fx:id="btnSignIn" focusTraversable="false" mnemonicParsing="false" styleClass="inline-link" text="Sign in" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </HBox>
   </children>
</StackPane>
