<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="650.0" prefWidth="1100.0" styleClass="root-pane" stylesheets="@../css/register.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom1.auction.client.Controller.RegisterController">
   <children>
      <HBox maxHeight="550.0" maxWidth="950.0" styleClass="main-card">
         <children>
            
            <StackPane HBox.hgrow="ALWAYS" styleClass="left-banner">
               <HBox.margin>
                  <Insets bottom="20.0" left="20.0" right="10.0" top="20.0" />
               </HBox.margin>
            </StackPane>

            <VBox alignment="CENTER_LEFT" prefWidth="480.0" spacing="25.0" HBox.hgrow="NEVER">
               <padding>
                  <Insets left="50.0" right="60.0" />
               </padding>
               <children>
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="title-text" text="Create an account" />
                        <Label styleClass="subtitle-text" text="Join 9999 other collectors and win your first bid" />
                     </children>
                  </VBox>

                  <VBox spacing="18.0">
                     <children>
                        <VBox spacing="8.0">
                           <Label styleClass="input-label" text="Username or Email" />
                           <TextField styleClass="input-field" text="" />
                        </VBox>
                        
                        <VBox spacing="8.0">
                           <Label styleClass="input-label" text="Password" />
                           <StackPane alignment="CENTER_RIGHT">
                              <PasswordField styleClass="input-field" text="" />
                              <Label styleClass="eye-icon" text="👁">
                                 <StackPane.margin>
                                    <Insets right="12.0" />
                                 </StackPane.margin>
                              </Label>
                           </StackPane>
                        </VBox>

                        <VBox spacing="8.0">
                           <Label styleClass="input-label" text="Confirm Password" />
                           <StackPane alignment="CENTER_RIGHT">
                              <PasswordField styleClass="input-field" text="" />
                              <Label styleClass="eye-icon" text="👁">
                                 <StackPane.margin>
                                    <Insets right="12.0" />
                                 </StackPane.margin>
                              </Label>
                           </StackPane>
                        </VBox>
                     </children>
                  </VBox>

                  <Button fx:id="btnRegister" maxHeight="48.0" maxWidth="Infinity" mnemonicParsing="false" styleClass="btn-primary" text="Register" />
                  
                  <HBox alignment="CENTER" spacing="5.0">
                     <Label styleClass="footer-text" text="Already have an account?" />
                     <Button fx:id="btnSignIn" styleClass="hyperlink-signin" text="Sign in" />
                  </HBox>
               </children>
            </VBox>
            
         </children>
      </HBox>
   </children>
</StackPane>