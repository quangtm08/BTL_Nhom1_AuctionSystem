<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@/css/admin/admin_overview.css"
            fx:controller="com.nhom1.auction.client.admin.controller.AdminOverviewController">
    <left>
        <fx:include source="components/admin_sidebar.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" hbarPolicy="NEVER">
            <VBox spacing="30" style="-fx-padding: 40;">
                <VBox spacing="8">
                    <Label text="Dashboard" style="-fx-font-family: 'Georgia'; -fx-font-style: italic; -fx-font-size: 36; -fx-text-fill: white;"/>
                    <Label fx:id="lblOverviewDate" text="System overview" style="-fx-text-fill: #555555;"/>
                </VBox>

                <HBox spacing="20">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="TOP_LEFT">
                            <Label text="Total Users" styleClass="stat-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <StackPane styleClass="icon-box"><Label text="Users" style="-fx-text-fill: #4d8055;"/></StackPane>
                        </HBox>
                        <Label fx:id="lblTotalUsersValue" text="--" styleClass="stat-value"/>
                        <Label fx:id="lblTotalUsersBreakdown" text="Loading..." styleClass="stat-label"/>
                    </VBox>

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="TOP_LEFT">
                            <Label text="Active Auctions" styleClass="stat-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <StackPane styleClass="icon-box"><Label text="Live" style="-fx-text-fill: #4d8055;"/></StackPane>
                        </HBox>
                        <Label fx:id="lblActiveAuctionsValue" text="--" styleClass="stat-value"/>
                        <Label fx:id="lblActiveAuctionsBreakdown" text="Loading..." styleClass="stat-label"/>
                    </VBox>
                </HBox>

                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    <VBox styleClass="section-card" HBox.hgrow="ALWAYS" prefWidth="500">
                        <Label text="Recent Activity" styleClass="section-title"/>
                        <Label text="Last dashboard sync" styleClass="stat-label">
                            <VBox.margin><Insets bottom="20"/></VBox.margin>
                        </Label>
                        <VBox spacing="15">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Circle radius="3" fill="#4d8055"/>
                                <Label fx:id="lblRecentActivityBody" text="Loading..." style="-fx-text-fill: #bbbbbb;" HBox.hgrow="ALWAYS"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblRecentActivityTime" text="..." style="-fx-text-fill: #555555;"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox styleClass="section-card" prefWidth="350">
                        <Label text="Session Status" styleClass="section-title"/>
                        <StackPane VBox.vgrow="ALWAYS">
                            <Circle fx:id="circleSessionStatus" radius="80" fill="transparent" stroke="#1a221e" strokeWidth="20"/>
                            <Label fx:id="lblSessionStatus" text="Loading..." style="-fx-text-fill: #555555;"/>
                        </StackPane>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
