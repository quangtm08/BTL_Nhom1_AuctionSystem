<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<HBox fx:id="mainContainer"
    prefHeight="800.0" prefWidth="1280.0" styleClass="root-pane" 
    stylesheets="@/css/client/auction_browse.css" xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom1.auction.client.user.controller.AuctionBrowseController" >

    <fx:include source="components/user_sidebar.fxml" />

    <VBox spacing="35.0" HBox.hgrow="ALWAYS" styleClass="main-content">
        <padding>
            <Insets top="60.0" left="60.0" right="60.0" bottom="30.0"/>
        </padding>
        <children>
            <Label text="Hunt for the next deal" fx:id="welcomeLabel" styleClass="header-title"/>
            
            <VBox spacing="20.0">
                <TextField promptText="Search..." styleClass="search-field"/>
                <HBox alignment="CENTER_LEFT">
                    <HBox spacing="10.0" HBox.hgrow="ALWAYS">
                        <Button text="All" styleClass="filter-chip, filter-chip-active"/>
                        <Button text="Electronics" styleClass="filter-chip"/>
                        <Button text="Arts" styleClass="filter-chip"/>
                        <Button text="Vehicles" styleClass="filter-chip"/>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Label text="Sort by" styleClass="sort-label" style="-fx-text-fill: #666666;"/>
                        <Button text="Ending soon" styleClass="filter-chip, filter-chip-active"/>
                    </HBox>
                </HBox>
            </VBox>

            <ScrollPane fitToWidth="true" styleClass="custom-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <GridPane fx:id="cardsGridPane" hgap="30.0" vgap="30.0">
                        <padding>
                            <Insets bottom="30.0" right="20.0" />
                        </padding>
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" percentWidth="50" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" percentWidth="50" />
                        </columnConstraints>
                        <children>
                            <!-- Dynamic cards will be added here via Controller -->
                        </children>
                    </GridPane>
                </content>
            </ScrollPane>
        </children>
    </VBox>
</HBox>