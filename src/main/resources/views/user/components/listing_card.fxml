<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nhom1.auction.client.user.controller.components.ListingCardComponentController"
      spacing="12.0" styleClass="product-card">
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="titleLabel" text="Untitled listing" styleClass="card-title-text"/>
            <Label fx:id="subLabel" text="Seller listing" styleClass="card-sub-text"/>
        </VBox>
        <Label fx:id="statusLabel" text="Running" styleClass="status-badge"/>
    </HBox>

    <HBox alignment="BOTTOM_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Current bid" styleClass="card-sub-text"/>
            <Label fx:id="priceLabel" text="0" styleClass="card-price-text" maxWidth="Infinity"/>
            <Label text="Listing" styleClass="card-sub-text"/>
        </VBox>
        <VBox alignment="BOTTOM_RIGHT">
            <Label fx:id="remainingLabel" text="-" styleClass="card-sub-text"/>
        </VBox>
    </HBox>

    <Separator styleClass="card-separator"/>

    <HBox spacing="10.0">
        <Button fx:id="editButton" text="Edit" styleClass="btn-card-edit" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="deleteButton" text="Delete" styleClass="btn-card-delete" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>
</VBox>
