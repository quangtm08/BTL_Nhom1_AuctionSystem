<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@/css/client/create_auction.css, @/css/client/common_ui.css"
            styleClass="listing-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhom1.auction.client.user.controller.CreateAuctionController">

    <left>
        <fx:include source="components/user_sidebar.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="custom-scroll" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="16.0" styleClass="listing-content">
                    <padding>
                        <Insets top="34.0" right="32.0" bottom="28.0" left="32.0"/>
                    </padding>

            <Button text="←  My listings" styleClass="btn-ghost" onAction="#handleBackToListings"/>
            <Label text="New listing" styleClass="page-title"/>

            <VBox spacing="8.0">
                <Label text="Title" styleClass="field-label"/>
                <TextField fx:id="titleField" promptText="e.g. Vintage Fender Stratocaster 1972" styleClass="field-input"/>
            </VBox>

            <HBox spacing="16.0">
                <VBox spacing="8.0" prefWidth="320.0" minWidth="320.0" maxWidth="320.0">
                    <Label text="Category" styleClass="field-label"/>
                    <ComboBox fx:id="categoryComboBox" promptText="Select a category" maxWidth="Infinity" styleClass="field-input"/>
                </VBox>
                <VBox spacing="8.0" prefWidth="320.0" minWidth="320.0" maxWidth="320.0">
                    <Label text="Condition" styleClass="field-label"/>
                    <ComboBox fx:id="conditionComboBox" promptText="Select condition" maxWidth="Infinity" styleClass="field-input"/>
                </VBox>
            </HBox>

            <VBox spacing="8.0">
                <Label text="Description" styleClass="field-label"/>
                <TextArea fx:id="descriptionArea" promptText="Describe the item - condition, history, any quirks..." prefRowCount="4" wrapText="true" styleClass="field-area"/>
            </VBox>

            <VBox alignment="CENTER" spacing="10.0" styleClass="upload-box">
                <Label text="Upload photos" styleClass="upload-title"/>
                <Label fx:id="uploadCountLabel" text="No photo selected" styleClass="upload-sub"/>
                <Label text="PNG, JPG up to 10MB. First image is the cover" styleClass="upload-sub"/>
                <Button text="Choose photos" styleClass="btn-secondary" onAction="#handleChoosePhotos"/>
            </VBox>

            <Separator styleClass="line-separator"/>

            <Label text="Auction settings" styleClass="section-title"/>

            <HBox spacing="16.0">
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="Starting bid" styleClass="field-label"/>
                    <TextField fx:id="startingBidField" promptText="1000" styleClass="field-input"/>
                </VBox>
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="Opening date &amp; time" styleClass="field-label"/>
                    <HBox spacing="8.0">
                        <DatePicker fx:id="openingDatePicker" promptText="Select opening date" maxWidth="Infinity" styleClass="field-input" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="startTimeField" promptText="HH:mm" styleClass="field-input" prefWidth="100.0"/>
                    </HBox>
                </VBox>
            </HBox>

            <VBox spacing="10.0">
                <Label text="Duration" styleClass="field-label"/>
                <HBox spacing="10.0">
                    <Button fx:id="duration1Btn" text="1 day" styleClass="duration-chip" onAction="#handleDurationPreset"/>
                    <Button fx:id="duration3Btn" text="3 days" styleClass="duration-chip" onAction="#handleDurationPreset"/>
                    <Button fx:id="duration7Btn" text="7 days" styleClass="duration-chip,duration-chip-active" onAction="#handleDurationPreset"/>
                    <Button fx:id="duration14Btn" text="14 days" styleClass="duration-chip" onAction="#handleDurationPreset"/>
                    <Button fx:id="duration30Btn" text="30 days" styleClass="duration-chip" onAction="#handleDurationPreset"/>
                    <TextField fx:id="customDurationField" promptText="Custom days" styleClass="duration-custom-input" prefWidth="130.0"/>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator styleClass="line-separator"/>

            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button text="Cancel" styleClass="btn-secondary"/>
                <Button text="Publish listing" styleClass="btn-primary" onAction="#handlePublishListing"/>
            </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
