<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.nhom1.auction.client.user.controller.AuctionDetailController"
            stylesheets="@/css/client/auction_detail.css, @/css/client/common_ui.css"
            styleClass="root">

    <VBox fx:id="loadingBox" spacing="10" alignment="CENTER" styleClass="container">
        <ProgressIndicator/>
        <Label text="Loading auction detail..."/>
    </VBox>

    <VBox fx:id="contentBox" spacing="30" styleClass="container" visible="false" managed="false">

        <!-- ===== TOP CARD ===== -->
        <Button text="← Back" styleClass="btn-ghost" fx:id="btnBack"/>

        <HBox spacing="30" styleClass="main-card">

            <!-- LEFT IMAGE -->
            <StackPane styleClass="main-image">
                <ImageView fx:id="itemImageView" preserveRatio="false" smooth="true" fitWidth="420" fitHeight="320"/>
            </StackPane>

            <!-- RIGHT CONTENT -->
            <VBox spacing="15" HBox.hgrow="ALWAYS">

                <Label fx:id="lblTitle" text="Loading..." styleClass="title"/>

                <!-- SELLER -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Circle radius="20" styleClass="avatar"/>
                    <VBox>
                        <Label text="Seller" styleClass="sub-text"/>
                        <Label fx:id="lblSellerName" text="" styleClass="seller-name"/>
                    </VBox>
                </HBox>

                <!-- BID BOX -->
                <VBox fx:id="bidBox" spacing="15" styleClass="bid-box">

                    <Label fx:id="lblExtensionToast"
                           text="⏱ Anti-sniping: +30s extension"
                           styleClass="extension-toast"
                           visible="false" managed="false"/>

                    <HBox alignment="CENTER_LEFT" styleClass="countdown-row">
                        <Label fx:id="lblCountdownLabel" text="Time remaining" styleClass="countdown-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblCountdown" text="--:--" styleClass="countdown-value"/>
                    </HBox>

                    <HBox>
                        <Label text="Current highest bid"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="10,000" fx:id="lblCurrentBid"/>
                    </HBox>

                    <HBox>
                        <Label text="Minimum increment"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="50" fx:id="lblMinIncrement"/>
                    </HBox>

                    <TextField promptText=" ENTER YOUR BID"
                               styleClass="bid-input" fx:id="txtBidInput"/>

                    <!-- Label báo lỗi nhập bid. Mặc định ẩn (managed=false = không chiếm space).
                         Hiện khi validate thất bại, ẩn ngay khi TextField được focus. -->
                    <Label fx:id="lblBidError" text="" styleClass="bid-error-label"
                           visible="false" managed="false"/>
                    <Label fx:id="lblAutoBidStatus" text="" styleClass="auto-bid-status-label"
                           visible="false" managed="false"/>

                    <HBox spacing="10">
                        <Button text="Place Bid" styleClass="btn-primary" fx:id="btnBid" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Auto-bid" fx:id="btnAutoBid" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Stop Auto-bid" fx:id="btnCancelAutoBid" styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>

                </VBox>

            </VBox>
        </HBox>

        <!-- ===== BOTTOM ===== -->
        <GridPane hgap="20">
            <columnConstraints>
                <ColumnConstraints percentWidth="60" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="40" hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- DESCRIPTION -->
            <VBox styleClass="card" GridPane.columnIndex="0">
                <Label text="Description" styleClass="section-title"/>
                <Label fx:id="lblDescription" wrapText="true"
                       text=""
                       styleClass="description"/>
            </VBox>

            <!-- BIDDINGS -->
            <VBox styleClass="card" spacing="12" GridPane.columnIndex="1">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Biddings" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnViewBidHistory" text="View chart →"
                            styleClass="btn-view-chart" focusTraversable="false"/>
                </HBox>
                <ScrollPane fitToWidth="true" prefHeight="400" vbarPolicy="ALWAYS" hbarPolicy="NEVER"
                            styleClass="bid-history-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="bidHistoryList" spacing="8"/>
                </ScrollPane>
            </VBox>

        </GridPane>

    </VBox>
</ScrollPane>
