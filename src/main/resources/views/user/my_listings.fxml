<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import java.net.URL?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@/css/client/my_listings.css, @/css/client/common_ui.css"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhom1.auction.client.user.controller.MyListingsController"
        >

    <!-- SIDEBAR -->

   <left>
        <fx:include source="components/user_sidebar.fxml" />
   </left>


    <!-- MAIN CONTENT -->
    <center>
        <StackPane styleClass="main-content">
            <!-- SKELETON LOADING -->
            <fx:include source="components/skeleton.fxml" fx:id="loadingBox" />

            <!-- ACTUAL CONTENT -->
            <VBox fx:id="contentBox" spacing="20" visible="false" managed="false">
                <padding>
                    <Insets top="40" left="40" right="40"/>
                </padding>

                <children>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="My Listings" styleClass="title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnCreateListing" text="+ New listing" styleClass="btn-primary" onAction="#handleCreateListing"/>
                    </HBox>

                    <!-- STATS -->
                    <HBox spacing="80">
                        <VBox spacing="5">
                            <Label text="Active listings" styleClass="stat-label"/>
                            <Label fx:id="activeListingsLabel" text="0" styleClass="big"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Ended listings" styleClass="stat-label"/>
                            <Label text="0" styleClass="big"/>
                        </VBox>
                    </HBox>

                    <!-- FILTER & SEARCH -->
                    <VBox spacing="20.0">
                        <TextField promptText="Search listings..." styleClass="search-field"/>
                        <HBox alignment="CENTER_LEFT">
                            <HBox spacing="10.0" HBox.hgrow="ALWAYS">
                                <Button text="All" styleClass="filter-chip, filter-chip-active"/>
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                <!-- Placeholder for future sort options if needed -->
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- CARD LIST -->
                    <ScrollPane fitToWidth="true" styleClass="custom-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <GridPane fx:id="listingsGrid" hgap="30.0" vgap="30.0">
                            <padding>
                                <Insets bottom="30.0" right="20.0" />
                            </padding>
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" percentWidth="50" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" percentWidth="50" />
                            </columnConstraints>
                        </GridPane>
                    </content>
                </ScrollPane>

                </children>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
