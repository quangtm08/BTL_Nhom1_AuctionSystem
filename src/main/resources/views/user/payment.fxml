<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<BorderPane fx:id="root" stylesheets="@/css/client/payment.css, @/css/client/common_ui.css" 
            prefHeight="650.0" prefWidth="1000.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom1.auction.client.user.controller.PaymentController">

   <left>
        <fx:include source="components/user_sidebar.fxml" />
   </left>

   <center>
      <ScrollPane fitToWidth="true" styleClass="main-scroll-pane">
         <content>
            <VBox spacing="26.0" styleClass="main-content">
               <children>
                  <Label styleClass="header-title" text="Cha-ching $" />
                  <Label fx:id="lblFeedback" styleClass="feedback-banner" text="Loading payments..." wrapText="true" />

                  <HBox spacing="24.0">
                     <children>
                        <VBox HBox.hgrow="ALWAYS" spacing="6.0" styleClass="stat-card">
                           <children>
                              <Label text="Pending to settle" styleClass="stat-label" />
                              <Label fx:id="lblPendingAmount" text="$0" styleClass="stat-value" />
                              <Label fx:id="lblPendingSummary" styleClass="stat-subtext" text="0 pending" />
                           </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="6.0" styleClass="stat-card">
                           <children>
                              <Label text="Completed payments" styleClass="stat-label" />
                              <Label fx:id="lblHistoryAmount" text="$0" styleClass="stat-value" />
                              <Label fx:id="lblHistorySummary" styleClass="stat-subtext" text="0 completed" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="section-label" text="TO PAY" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="section-helper" text="Win an auction and settle it here." />
                     </children>
                  </HBox>
                  
                  <VBox fx:id="pendingContainer" alignment="CENTER_LEFT" spacing="12.0" styleClass="payment-card" />

                  <Separator styleClass="content-divider" />

                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="section-label" text="HISTORY" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="section-helper" text="Paid wins are archived here." />
                     </children>
                  </HBox>
                  
                  <VBox fx:id="historyContainer" spacing="0.0" styleClass="history-card" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
